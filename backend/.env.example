# ─────────────────────────────────────────────────────────────────────────────
# RiskPilot AI — Delta Exchange India Testnet Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
#
# SECURITY: This file is safe to commit ONLY because credentials are BLANK below.
#            The actual backend/.env file MUST NEVER be committed — it is in .gitignore.
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:   copy .env.example .env     (run from the backend/ directory)
#   2. Fill in your fresh India Testnet API key and secret in the .env file ONLY.
#   3. Verify it is ignored by Git:  git status --ignored
#
# CREDENTIAL SECURITY RULES:
#   - NEVER paste your API key or secret into AI chat, GitHub, screenshots, or logs.
#   - Credentials must ONLY be stored in your local backend/.env file.
#   - If you previously exposed credentials, revoke them immediately at:
#     https://cdn-ind.testnet.deltaex.org  =>  Profile -> API Keys -> Revoke
#   - Create fresh India Testnet credentials at the same URL.
#   - NEVER fill in credentials in this .env.example file — it belongs in git.
#
# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT (must always be india_testnet — production is blocked at code level)
# ─────────────────────────────────────────────────────────────────────────────
DELTA_ENV=india_testnet

# ─────────────────────────────────────────────────────────────────────────────
# OFFICIAL DELTA EXCHANGE INDIA TESTNET ENDPOINTS (verified Oct 2024)
# Do NOT change these unless Delta Exchange officially updates their URLs.
# Production endpoints will be rejected automatically at startup.
# ─────────────────────────────────────────────────────────────────────────────
DELTA_REST_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_PUBLIC_URL=wss://socket-ind-pub.testnet.deltaex.org
DELTA_WS_PRIVATE_URL=wss://socket-ind.testnet.deltaex.org

# ─────────────────────────────────────────────────────────────────────────────
# API CREDENTIALS — Leave blank for Demo / Simulation Mode
# Fill in your India Testnet credentials in backend/.env ONLY (never here).
# ─────────────────────────────────────────────────────────────────────────────
DELTA_API_KEY=
DELTA_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=true
DB_PATH=riskpilot.db
